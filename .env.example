# Solid Pod environment variables (required for CLI + web screen Solid mode)
SOLID_OIDC_ISSUER=https://solidcommunity.net
SOLID_CLIENT_ID=your-client-id
SOLID_CLIENT_SECRET=your-client-secret
SOLID_REFRESH_TOKEN=your-refresh-token
SOLID_POD_BASE_URL=https://your-pod-url/

# Token type (optional, defaults to "DPoP")
# SOLID_TOKEN_TYPE=Bearer

# Auth retry configuration (optional, defaults shown below)
# SOLID_AUTH_MAX_RETRIES=2
# SOLID_AUTH_RETRY_DELAY_MS=2000

# Notes container URL (optional, derived from SOLID_POD_BASE_URL if not set)
# SOLID_NOTES_CONTAINER_URL=https://your-pod-url/notes/

# Summaries container URL (optional, derived from SOLID_POD_BASE_URL if not set)
# SOLID_SUMMARIES_CONTAINER_URL=https://your-pod-url/summaries/

# Summarizer configuration
SUMMARIZER_PROVIDER=mock  # "mock" (default) or "openai"
OPENAI_API_KEY=sk-your-openai-key  # Required when SUMMARIZER_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini  # Optional, default: gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1  # Optional, default: https://api.openai.com/v1
# OPENAI_BASE_URL can point at OpenRouter.ai: https://openrouter.ai/api/v1
# OPENAI_BASE_URL can point at local Ollama: http://localhost:11434/v1

# Web screen mode (optional, defaults to "demo")
# PODPAD_WEB_MODE=demo  # "demo" (default) or "solid"
# PODPAD_WEB_MODE=solid  # Set to "solid" to connect to your Pod via the web screen