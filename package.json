{
  "name": "podpad",
  "version": "0.1.0",
  "private": true,
  "description": "CLI-first learning project for AI agents + Solid Pods.",
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-web-assets.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "web": "tsx src/web/server.ts",
    "start": "node dist/cli.js",
    "test": "node --require tsx/cjs --test tests/**/*.test.ts",
    "auth:register": "python scripts/register_client.py",
    "auth:code": "python scripts/request_auth_code.py",
    "auth:token": "python scripts/exchange_auth_code.py",
    "auth:check": "node scripts/auth-check.mjs",
    "auth:setup": "node scripts/auth-setup.mjs"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@inrupt/solid-client-authn-node": "^1.12.1"
  }
}
